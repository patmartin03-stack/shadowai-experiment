# =============================================================
# Variables de entorno — Shadow AI
# =============================================================
# Copia este archivo a ".env" (o configúralas en tu plataforma de
# despliegue, p. ej. Render) y rellena los valores reales.
# NUNCA subas el archivo .env con credenciales reales al repositorio.

# Clave de API de OpenAI. Habilita el botón "Ayuda de IA" (endpoint /ai-suggest).
# Si se deja vacía, el experimento funciona pero las sugerencias de IA no estarán disponibles.
OPENAI_API_KEY=sk-...

# Credenciales de una cuenta de servicio de Google (JSON completo en una sola línea).
# Imprescindible para guardar los datos en Google Sheets.
# Se obtiene en Google Cloud Console → IAM → Cuentas de servicio → Claves.
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"...","..."}

# Nombre del documento de Google Sheets donde se guardan los datos.
# La cuenta de servicio (client_email) debe tener permiso de edición sobre él.
GOOGLE_SHEET_NAME=Shadow AI - Experimento
